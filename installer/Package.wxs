<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Wii2Xbox"
           Manufacturer="Iván Fernández"
           Version="$(var.ProductVersion)"
           UpgradeCode="F6ADEE8B-98F0-49F1-BBEB-EDC0C5A9F748"
           Scope="perUser"
           Language="!(loc.PackageLanguage)">
    <MajorUpgrade Schedule="afterInstallExecute" AllowSameVersionUpgrades="yes" IgnoreLanguage="yes"
                  DowngradeErrorMessage="!(loc.DowngradeBlocked)" />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.InstallerLicense)" />
    <Binary Id="LanguageSelector" SourceFile="$(var.LanguageSelector)" />
    <CustomAction Id="SelectSetupLanguage" BinaryRef="LanguageSelector" DllEntry="SelectSetupLanguage"
                  Execute="immediate" Return="check" />
    <InstallUISequence>
      <Custom Action="SelectSetupLanguage" Before="PrepareDlg" />
    </InstallUISequence>
    <Property Id="ARPPRODUCTICON" Value="Wii2Xbox.ico" />
    <Icon Id="Wii2Xbox.ico" SourceFile="$(sys.SOURCEFILEDIR)..\src\Wii2Xbox\Resources\Wii2Xbox.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="InstallFolder" Name="Wii2Xbox" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuEntry">
        <Shortcut Id="StartMenuShortcut" Name="Wii2Xbox"
                  Target="[InstallFolder]Wii2Xbox.exe" WorkingDirectory="InstallFolder" />
        <RegistryValue Root="HKCU" Key="Software\Wii2Xbox\Installer"
                       Name="ExecutablePath" Value="[InstallFolder]Wii2Xbox.exe" Type="string" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <DirectoryRef Id="InstallFolder">
      <Component Id="InstalledStartup" NeverOverwrite="yes">
        <RemoveFolder Id="RemoveEmptyProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="Wii2Xbox.Installed" Value="" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Application" Title="Wii2Xbox">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="PayloadDirectoryCleanup" />
      <ComponentRef Id="StartMenuEntry" />
      <ComponentRef Id="InstalledStartup" />
    </Feature>
  </Package>
</Wix>
